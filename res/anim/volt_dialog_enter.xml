<?xml version="1.0" encoding="utf-8"?>
<!-- Centered dialogs fade in and rise a little. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/volt_standard" android:shareInterpolator="true">
    <translate android:fromYDelta="6%" android:toYDelta="0" android:duration="260" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
</set>
