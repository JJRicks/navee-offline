<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen pages slide a short distance in from the side as they fade up. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/volt_standard" android:shareInterpolator="true">
    <translate android:fromXDelta="12%" android:toXDelta="0" android:duration="280" />
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="200" />
</set>
